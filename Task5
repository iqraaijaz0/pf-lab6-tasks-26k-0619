#include <stdio.h>

int main() {
    while (1) {
        int access_num;
        printf("Enter access number: ");
        scanf("%d", &access_num);

        if (access_num == 9999) {
            break;
        }

        int hr;
        printf("Enter current hour (0-23): ");
        scanf("%d", &hr);

        int is_late = (hr >= 22 || hr < 6) ? 1 : 0;

        if (is_late == 1) {
            printf("MODE: LATE NIGHT MODE\n");
        } else {
            printf("MODE: STANDARD MODE\n");
        }

        int allowed = 0;

        if (is_late == 0) {
            if ((access_num & 1) != 0 || (access_num & 2) != 0 || (access_num & 4) != 0) {
                allowed = 1;
            }
        } else {
            if ((access_num & 8) != 0) {
                allowed = 1;
            }
        }

        if (allowed == 1) {
            printf("Access: GRANTED\n");
        } else {
            printf("Access: DENIED\n");
        }

        if ((access_num & 4) != 0) {
            printf("Info: Member has Personal Trainer Access\n");
        }
        printf("\n");
    }

    return 0;
}
