#include <stdio.h>

int main() {
    int total_students;
    printf("Enter number of students: ");
    scanf("%d", &total_students);

    for (int i = 0; i < total_students; i++) {
        int m1, m2, m3;
        printf("Enter marks for 3 subjects: ");
        scanf("%d %d %d", &m1, &m2, &m3);

        int avg = (m1 + m2 + m3) / 3;
        int check = avg / 10;
        char grade;

        switch (check) {
            case 10:
            case 9:
                grade = 'A';
                break;
            case 8:
                grade = 'B';
                break;
            case 7:
                grade = 'C';
                break;
            case 6:
                grade = 'D';
                break;
            default:
                grade = 'F';
                break;
        }

        int passed = (avg >= 60 && m1 >= 40 && m2 >= 40 && m3 >= 40) ? 1 : 0;

        printf("Average: %d, Grade: %c\n", avg, grade);
        if (passed == 1) {
            printf("Result: PASSED\n");
        } else {
            printf("Result: FAILED\n");
        }
        printf("\n");
    }

    return 0;
}
